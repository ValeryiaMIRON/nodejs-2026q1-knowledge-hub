PORT=4000

CRYPT_SALT=10
JWT_SECRET=your_access_token_secret
JWT_REFRESH_SECRET=your_refresh_token_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=knowledge_hub
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Local app + docker db
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/knowledge_hub?schema=public&connection_limit=5"
# Docker app + docker db (used in docker-compose app service override)
# DATABASE_URL="postgresql://postgres:postgres@db:5432/knowledge_hub?schema=public&connection_limit=5"

LOG_LEVEL=log
LOG_MAX_FILE_SIZE=1024
